<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>كود الدعوة — miningusdt</title>
  <link rel="stylesheet" href="style.css">
  <script defer src="script.js"></script>
  <style>
    .referral-page-card {
      max-width: 600px;
      margin: 40px auto;
      padding: 45px 35px;
      border-radius: 30px;
      background: linear-gradient(145deg, rgba(8, 24, 31, 0.98), rgba(3, 10, 15, 0.98));
      border: 2px solid rgba(255, 215, 0, 0.15);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 60px rgba(255, 215, 0, 0.05);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .referral-page-card::before {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 30px;
      padding: 2px;
      background: linear-gradient(135deg, #ffd700, #00ff9d, #ffd700);
      background-size: 300% 300%;
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      animation: referralBorderGlow 4s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes referralBorderGlow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .referral-page-card .big-icon {
      font-size: 72px;
      margin-bottom: 10px;
      animation: iconFloat 3s ease-in-out infinite;
    }

    @keyframes iconFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    .referral-page-card h1 {
      font-size: 34px;
      font-weight: 900;
      background: linear-gradient(135deg, #ffd700, #ffaa00);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 5px;
    }

    .referral-page-card .subtitle {
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 25px;
    }

    .referral-page-card .code-box {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      padding: 20px 25px;
      border-radius: 16px;
      background: rgba(0, 0, 0, 0.4);
      border: 2px solid rgba(255, 215, 0, 0.15);
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .referral-page-card .code-box .code-value {
      font-size: 36px;
      font-weight: 800;
      font-family: 'Courier New', monospace;
      letter-spacing: 4px;
      background: linear-gradient(135deg, #ffd700, #ffaa00, #ffd700);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: codeShine 3s ease-in-out infinite;
      direction: ltr;
    }

    @keyframes codeShine {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .referral-page-card .copy-btn-big {
      padding: 12px 28px;
      border-radius: 14px;
      border: 2px solid rgba(255, 215, 0, 0.25);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.08), rgba(255, 215, 0, 0.02));
      color: #ffd700;
      font-weight: 700;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .referral-page-card .copy-btn-big:hover {
      transform: translateY(-3px) scale(1.02);
      border-color: #ffd700;
      box-shadow: 0 0 40px rgba(255, 215, 0, 0.2);
      background: rgba(255, 215, 0, 0.12);
    }

    .referral-page-card .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 25px 0;
    }

    .referral-page-card .stat-item {
      padding: 16px;
      border-radius: 16px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .referral-page-card .stat-item .num {
      font-size: 28px;
      font-weight: 800;
      color: #ffd700;
    }

    .referral-page-card .stat-item .num.green {
      color: #00ff9d;
    }
    .referral-page-card .stat-item .num.blue {
      color: #32b8ff;
    }

    .referral-page-card .stat-item .label {
      color: var(--muted);
      font-size: 12px;
      margin-top: 4px;
    }

    .referral-page-card .share-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 20px;
    }

    .referral-page-card .share-buttons button {
      padding: 12px 20px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      justify-content: center;
      min-width: 100px;
    }

    .referral-page-card .share-buttons button:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 215, 0, 0.2);
      background: rgba(255, 215, 0, 0.04);
    }

    .referral-page-card .share-buttons .telegram { border-color: rgba(0, 136, 204, 0.2); }
    .referral-page-card .share-buttons .telegram:hover { border-color: #0088cc; background: rgba(0, 136, 204, 0.08); }
    .referral-page-card .share-buttons .whatsapp { border-color: rgba(37, 211, 102, 0.2); }
    .referral-page-card .share-buttons .whatsapp:hover { border-color: #25d366; background: rgba(37, 211, 102, 0.08); }
    .referral-page-card .share-buttons .twitter { border-color: rgba(29, 161, 242, 0.2); }
    .referral-page-card .share-buttons .twitter:hover { border-color: #1da1f2; background: rgba(29, 161, 242, 0.08); }

    .referral-page-card .hint {
      color: var(--muted);
      font-size: 13px;
      margin-top: 20px;
      padding: 15px;
      border-radius: 14px;
      background: rgba(255, 215, 0, 0.04);
      border: 1px solid rgba(255, 215, 0, 0.06);
    }

    .referral-page-card .back-link {
      display: inline-block;
      margin-top: 20px;
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .referral-page-card .back-link:hover {
      color: var(--green);
    }

    @media (max-width: 620px) {
      .referral-page-card {
        padding: 30px 18px;
        margin: 20px 10px;
      }
      .referral-page-card h1 {
        font-size: 26px;
      }
      .referral-page-card .code-box .code-value {
        font-size: 26px;
        letter-spacing: 2px;
      }
      .referral-page-card .stats-grid {
        grid-template-columns: 1fr 1fr;
      }
      .referral-page-card .share-buttons button {
        flex: 1 1 100%;
      }
    }

    @media (max-width: 400px) {
      .referral-page-card .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<header class="navbar">
  <div class="container nav-inner">
    <a class="brand" href="index.html">
      <span class="logo-mark">₮</span>
      <span>mining<span>usdt</span></span>
    </a>
    <nav class="nav-links">
      <a href="index.html" data-i18n="home">الرئيسية</a>
      <a href="plans.html" data-i18n="plans">خطط التعدين</a>
      <a href="deposit.html" data-i18n="deposit">الإيداع</a>
      <a href="withdraw.html" data-i18n="withdraw">السحب</a>
      <a href="dashboard.html" data-i18n="profits">الأرباح</a>
      <a href="referral.html" data-i18n="referral" style="color: #ffd700; font-weight: 700;">🎯 كود الدعوة</a>
      <a href="contact.html" data-i18n="contact">تواصل معنا</a>
    </nav>
    <div class="nav-actions">
      <div class="lang-wrap">
        <button id="globeBtn" class="icon-btn">🌐</button>
        <div id="langMenu" class="lang-menu">
          <button data-lang="ar">العربية</button>
          <button data-lang="en">English</button>
          <button data-lang="tr">Türkçe</button>
        </div>
      </div>
      <a class="primary-btn" href="dashboard.html" data-i18n="dashboard">Dashboard</a>
      <button id="mobileToggle" class="icon-btn mobile-toggle">☰</button>
    </div>
  </div>
</header>

<main class="section">
  <div class="container">
    <div class="referral-page-card">
      <div class="big-icon">🎯</div>
      <h1>كود الدعوة الخاص بك</h1>
      <p class="subtitle">شارك الكود مع أصدقائك واحصل على عمولة 10% من كل إيداع!</p>

      <div class="code-box">
        <span class="code-value" id="referralCodeDisplay">—</span>
        <button class="copy-btn-big" id="copyReferralCodeBtn">
          📋 نسخ الكود
        </button>
      </div>

      <div class="stats-grid">
        <div class="stat-item">
          <div class="num green" id="referralBonusDisplay">$0.00</div>
          <div class="label">💰 إجمالي العمولات</div>
        </div>
        <div class="stat-item">
          <div class="num blue" id="referralCountDisplay">0</div>
          <div class="label">👥 عدد المدعوين</div>
        </div>
        <div class="stat-item">
          <div class="num">10%</div>
          <div class="label">🎁 نسبة العمولة</div>
        </div>
      </div>

      <div class="share-buttons">
        <button class="telegram" data-share="telegram">📱 تيليجرام</button>
        <button class="whatsapp" data-share="whatsapp">💬 واتساب</button>
        <button class="twitter" data-share="twitter">🐦 تويتر</button>
        <button class="copy-link" data-share="copy" style="border-color: rgba(255, 215, 0, 0.15);">🔗 نسخ الرابط</button>
      </div>

      <div class="hint">
        💡 شارك هذا الكود مع أصدقائك — تحصل على <strong style="color: #ffd700;">10%</strong> من كل إيداع يقومون به!
      </div>

      <a href="dashboard.html" class="back-link">← العودة إلى لوحة التحكم</a>
    </div>
  </div>
</main>

<div id="toast" class="toast"></div>

<footer class="footer">
  <div class="container">
    <div class="copyright" data-i18n="copyright">© 2026 miningusdt</div>
  </div>
</footer>

<script>
  // =========================================================
  //   REFERRAL PAGE - FULLY WORKING
  // =========================================================

  const API_URL = window.location.origin + '/api';

  function getCurrentUser() {
    try {
      return JSON.parse(localStorage.getItem('currentUser'));
    } catch (e) {
      return null;
    }
  }

  function toast(message) {
    const el = document.getElementById('toast');
    if (!el) return;
    el.textContent = message;
    el.classList.add('show');
    clearTimeout(window.toastTimer);
    window.toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
  }

  function loadReferralData() {
    const user = getCurrentUser();
    if (!user) {
      document.getElementById('referralCodeDisplay').textContent = '—';
      document.getElementById('referralBonusDisplay').textContent = '$0.00';
      document.getElementById('referralCountDisplay').textContent = '0';
      toast('⚠️ يرجى تسجيل الدخول أولاً');
      setTimeout(() => {
        window.location.href = 'login.html';
      }, 1500);
      return;
    }

    // عرض كود الدعوة
    const codeEl = document.getElementById('referralCodeDisplay');
    if (user.referralCode) {
      codeEl.textContent = user.referralCode;
    } else {
      codeEl.textContent = '—';
    }

    // عرض العمولات
    const bonusEl = document.getElementById('referralBonusDisplay');
    bonusEl.textContent = '$' + Number(user.referralBonus || 0).toFixed(2);

    // عرض عدد المدعوين
    const countEl = document.getElementById('referralCountDisplay');
    const referredCount = (user.referredUsers || []).length;
    countEl.textContent = referredCount;
  }

  // =========================================================
  //   COPY BUTTON
  // =========================================================
  document.getElementById('copyReferralCodeBtn')?.addEventListener('click', function() {
    const codeEl = document.getElementById('referralCodeDisplay');
    const code = codeEl.textContent.trim();
    if (!code || code === '—') {
      toast('⚠️ لا يوجد كود دعوة');
      return;
    }
    navigator.clipboard.writeText(code).then(() => {
      toast('✅ تم نسخ الكود!');
      this.innerHTML = '✅ تم النسخ';
      setTimeout(() => {
        this.innerHTML = '📋 نسخ الكود';
      }, 2000);
    }).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = code;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      toast('✅ تم نسخ الكود!');
    });
  });

  // =========================================================
  //   SHARE BUTTONS
  // =========================================================
  document.querySelectorAll('[data-share]').forEach(btn => {
    btn.addEventListener('click', function() {
      const codeEl = document.getElementById('referralCodeDisplay');
      const code = codeEl.textContent.trim();
      if (!code || code === '—') {
        toast('⚠️ لا يوجد كود دعوة');
        return;
      }

      const shareText = `🎯 انضم إليّ على منصة التعدين واستخدم كود الدعوة الخاص بي: ${code}`;
      const url = window.location.origin + '/register.html';
      const encodedText = encodeURIComponent(shareText);
      const encodedUrl = encodeURIComponent(url);

      let shareLink = '';

      switch(this.dataset.share) {
        case 'telegram':
          shareLink = `https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`;
          break;
        case 'whatsapp':
          shareLink = `https://api.whatsapp.com/send?text=${encodedText}%0A${encodedUrl}`;
          break;
        case 'twitter':
          shareLink = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
          break;
        case 'copy':
          navigator.clipboard.writeText(`${shareText}\n${url}`).then(() => {
            toast('✅ تم نسخ الرابط!');
          }).catch(() => {
            const ta = document.createElement('textarea');
            ta.value = `${shareText}\n${url}`;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
            toast('✅ تم نسخ الرابط!');
          });
          return;
        default:
          return;
      }

      if (shareLink) {
        window.open(shareLink, '_blank', 'width=600,height=500');
      }
    });
  });

  // =========================================================
  //   LANGUAGE MENU & MOBILE TOGGLE
  // =========================================================
  document.getElementById('globeBtn')?.addEventListener('click', function(e) {
    e.stopPropagation();
    document.getElementById('langMenu').classList.toggle('show');
  });

  document.querySelectorAll('#langMenu [data-lang]').forEach(btn => {
    btn.addEventListener('click', function() {
      const lang = this.dataset.lang;
      localStorage.setItem('siteLang', lang);
      document.documentElement.lang = lang;
      document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
      document.getElementById('langMenu').classList.remove('show');
      location.reload();
    });
  });

  document.addEventListener('click', function(e) {
    const menu = document.getElementById('langMenu');
    const globe = document.getElementById('globeBtn');
    if (menu && globe && !menu.contains(e.target) && !globe.contains(e.target)) {
      menu.classList.remove('show');
    }
  });

  document.getElementById('mobileToggle')?.addEventListener('click', function() {
    document.querySelector('.nav-links').classList.toggle('open');
  });

  // =========================================================
  //   INIT
  // =========================================================
  loadReferralData();

  // تحديث البيانات كل 30 ثانية
  setInterval(() => {
    const user = getCurrentUser();
    if (user) {
      loadReferralData();
    }
  }, 30000);
</script>

</body>
</html>
